rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in, and (for accounts with 2FA on) this sign-in passed 2FA. `tfaSessions` holds the
    // `auth_time` of verified sign-ins (server/utils/two-factor-claims.ts), so a password alone
    // reaches no business data. Only the caller's own profile and staff record skip it: the app
    // reads them to show the 2FA prompt.
    function signedIn() {
      return request.auth != null;
    }

    function tfaSatisfied() {
      return request.auth.token.get('twoFactorEnabled', false) != true ||
        request.auth.token.auth_time in request.auth.token.get('tfaSessions', []);
    }

    function isAuthenticated() {
      return signedIn() && tfaSatisfied();
    }
    
    // Collection group queries for staff - allows searching across all staff collections
    // This is used when staff members need to find their own documents
    // IMPORTANT: For collection group queries, Firestore evaluates the query against potential results
    // The query where('authUid', '==', request.auth.uid) must only match documents where
    // resource.data.authUid == request.auth.uid is true. This rule ensures that.
    // The {path=**} pattern matches any path, allowing collection group queries across all stores
    // This rule MUST come before the nested staff rules to ensure collection group queries work
    match /{path=**}/staff/{staffId} {
      // Allow read (covers both get and list/collection group operations) if:
      // 1. User is authenticated
      // 2. The document's authUid matches the authenticated user's UID
      // This allows staff members to find their own documents via collection group queries
      // When querying with where('authUid', '==', request.auth.uid), Firestore will only
      // return documents where this condition evaluates to true
      // 
      // NOTE: If authUid is missing or null, the comparison will fail (which is correct security)
      allow read: if signedIn() &&
                   resource.data.authUid == request.auth.uid;
      
      // TEMPORARY DEBUG RULE (for testing only - REMOVE after debugging)
      // Uncomment the line below to temporarily allow all authenticated users to read staff
      // This helps confirm if the issue is authUid matching or something else
      // If this fixes it, then the problem is authUid field mismatch in your documents
      // allow read: if isAuthenticated();
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user owns the store (super admin)
    function ownsStore(userId, storeId) {
      return isAuthenticated() && 
             userId == request.auth.uid &&
             exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)) &&
             (
               !get(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)).data.keys().hasAny(['ownerId']) ||
               get(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)).data.ownerId == request.auth.uid
             );
    }

    // Membership docs are stored at:
    // users/{userId}/stores/{storeId}/members/{memberAuthUid}
    function hasStoreMembership(userId, storeId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid));
    }

    function isActiveStoreMember(userId, storeId) {
      return hasStoreMembership(userId, storeId) &&
             get(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)).data.status == 'active';
    }

    // Raw member doc for the calling user (only meaningful once isActiveStoreMember() is true).
    function memberData(userId, storeId) {
      return get(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)).data;
    }

    // Pre-permission-matrix members only have `role` + the 2 legacy boolean grants. Mirrors
    // utils/staff-permissions.ts#deriveDefaultPermissions exactly so authorization is identical
    // for a doc whether or not it has been backfilled with a `permissions` map yet.
    function legacyHasPermission(member, moduleName, action) {
      let isManager = member.role == 'manager';
      let inventoryManaged = isManager && member.get('canManageInventory', false) == true;
      let hadRefundAccess = isManager || member.get('canManageReceipts', false) == true;
      let elevated = inventoryManaged || isManager || hadRefundAccess;

      return moduleName == 'products'
        ? (action == 'view' || inventoryManaged)
        : moduleName == 'receipts'
          ? (action == 'view' || action == 'create'
              ? true
              : action == 'edit'
                ? isManager
                : action == 'refund'
                  ? hadRefundAccess
                  : false)
          : moduleName == 'leads'
            ? (action == 'view' || action == 'create' || action == 'edit'
                ? true
                : action == 'delete' ? elevated : false)
            : moduleName == 'buybacks'
              ? (action == 'view' || action == 'create' || action == 'edit'
                  ? inventoryManaged
                  : false)
              : moduleName == 'sellerLoans'
                ? (action == 'view' || action == 'create' || action == 'edit'
                    ? true
                    : false)
                : moduleName == 'multiStoreSync'
                  ? false
                  : false;
    }

    // Single source of truth for "can this member do <action> on <moduleName>". checks the new
    // `permissions` map when present (falling back to legacy for modules not yet stored), else
    // falls back to the legacy role/grant fields entirely.
    // A branch admin holds every module action except payments, financial figures, and stock
    // transfers. Transfers need the owner-set adminGrants.stockTransfers extra.
    // Mirrors utils/staff-permissions.ts#resolveStaffPermissions.
    function memberHasPermission(userId, storeId, moduleName, action) {
      return isActiveStoreMember(userId, storeId) &&
        ((memberData(userId, storeId).get('admin', false) == true &&
          !(moduleName in ['payments', 'financials', 'multiStoreSync'])) ||
        (memberData(userId, storeId).get('admin', false) == true &&
          moduleName == 'multiStoreSync' &&
          memberData(userId, storeId).get('adminGrants', {}).get('stockTransfers', false) == true) ||
        (memberData(userId, storeId).keys().hasAny(['permissions'])
          ? (memberData(userId, storeId).permissions.keys().hasAny([moduleName])
              ? memberData(userId, storeId).permissions.get(moduleName, {}).get(action, false) == true
              : legacyHasPermission(memberData(userId, storeId), moduleName, action))
          : legacyHasPermission(memberData(userId, storeId), moduleName, action)));
    }

    // Branch admin (owner-set `admin: true` on the member doc). Reads the store's roster and
    // manages departments directly; staff and member records change only through server routes.
    function isStoreAdmin(userId, storeId) {
      return isActiveStoreMember(userId, storeId) &&
        memberData(userId, storeId).get('admin', false) == true;
    }

    function storeAdminHasGrant(userId, storeId, grant) {
      return isStoreAdmin(userId, storeId) &&
        memberData(userId, storeId).get('adminGrants', {}).get(grant, false) == true;
    }

    // Branch admin of their home store with the stock-transfers extra. Used so they can see other
    // branches' names and category lists when requesting a stock transfer on Enterprise.
    function workspaceMemberPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/workspaceMembers/$(request.auth.uid);
    }

    function isActiveWorkspaceAdmin(userId) {
      return isAuthenticated() &&
        exists(workspaceMemberPath(userId)) &&
        get(workspaceMemberPath(userId)).data.status == 'active' &&
        storeAdminHasGrant(userId, get(workspaceMemberPath(userId)).data.storeId, 'stockTransfers');
    }

    function memberHasAnyProductsManage(userId, storeId) {
      return memberHasPermission(userId, storeId, 'products', 'create')
        || memberHasPermission(userId, storeId, 'products', 'edit')
        || memberHasPermission(userId, storeId, 'products', 'delete');
    }

    // Any grant that implies elevated (non-view-only) access. Used for lighter-weight collections
    // (customers, notifications) that still gate on "trusted staff" rather than a dedicated module.
    function memberHasAnyManage(userId, storeId) {
      return memberHasAnyProductsManage(userId, storeId)
        || memberHasPermission(userId, storeId, 'receipts', 'edit')
        || memberHasPermission(userId, storeId, 'receipts', 'delete')
        || memberHasPermission(userId, storeId, 'receipts', 'refund')
        || memberHasPermission(userId, storeId, 'leads', 'create')
        || memberHasPermission(userId, storeId, 'leads', 'edit')
        || memberHasPermission(userId, storeId, 'leads', 'delete')
        || memberHasPermission(userId, storeId, 'buybacks', 'create')
        || memberHasPermission(userId, storeId, 'buybacks', 'edit')
        || memberHasPermission(userId, storeId, 'buybacks', 'delete')
        || memberHasPermission(userId, storeId, 'sellerLoans', 'create')
        || memberHasPermission(userId, storeId, 'sellerLoans', 'edit')
        || memberHasPermission(userId, storeId, 'sellerLoans', 'delete')
        || memberHasPermission(userId, storeId, 'multiStoreSync', 'create')
        || memberHasPermission(userId, storeId, 'multiStoreSync', 'edit')
        || memberHasPermission(userId, storeId, 'multiStoreSync', 'delete');
    }

    // Business account owner (path users/{userId} matches auth).
    function isStoreOwnerForPath(userId) {
      return isAuthenticated() && userId == request.auth.uid;
    }

    // Subscription tier on the account owner doc (users/{userId}). Staff inherit owner plan.
    function ownerSubscriptionRaw(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        ? get(/databases/$(database)/documents/users/$(userId)).data.get('subscription', 'storvv_micro')
        : 'storvv_micro';
    }

    // Free trial: the server stamps trialEndsAt (a timestamp) on the owner doc; owners cannot
    // write it. Mirrors isTrialActive / TRIAL_PLAN in types/subscription.ts.
    function ownerTrialActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.get('trialEndsAt', null) is timestamp
        && get(/databases/$(database)/documents/users/$(userId)).data.trialEndsAt > request.time;
    }

    function normalizedOwnerPlan(userId) {
      let raw = ownerSubscriptionRaw(userId);
      let stored = raw == 'storvv_medium' || raw == 'medium'
        ? 'storvv_medium'
        : (raw == 'storvv_enterprise' || raw == 'enterprise' ? 'storvv_enterprise' : 'storvv_micro');
      return stored == 'storvv_micro' && ownerTrialActive(userId) ? 'storvv_enterprise' : stored;
    }

    function planAtLeastMedium(userId) {
      let plan = normalizedOwnerPlan(userId);
      return plan == 'storvv_medium' || plan == 'storvv_enterprise';
    }

    function planIsEnterprise(userId) {
      return normalizedOwnerPlan(userId) == 'storvv_enterprise';
    }

    // Over the plan's limits the extra stores, and the extra staff in a store, are view only.
    // The server saves `planTier` on each store doc and member doc: the lowest plan that keeps it
    // fully usable (0 Micro, 1 Medium, 2 Enterprise). Missing means no limit yet. Compared with the
    // owner's plan here, so upgrades, downgrades and trial ends apply at once.
    // Mirrors utils/plan-access.ts#planTierForPosition and server/utils/plan-tiers.ts.
    function ownerPlanRank(userId) {
      let plan = normalizedOwnerPlan(userId);
      return plan == 'storvv_enterprise' ? 2 : (plan == 'storvv_medium' ? 1 : 0);
    }

    function storeWithinPlan(userId, storeId) {
      return !exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)) ||
        get(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)).data.get('planTier', 0)
          <= ownerPlanRank(userId);
    }

    function callerWithinPlan(userId, storeId) {
      return request.auth.uid == userId ||
        !exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)).data.get('planTier', 0)
          <= ownerPlanRank(userId);
    }

    function planAllowsStoreWrite(userId, storeId) {
      return storeWithinPlan(userId, storeId) && callerWithinPlan(userId, storeId);
    }

    function planTierUnchanged() {
      return request.resource.data.get('planTier', null) == resource.data.get('planTier', null);
    }

    function canAccessStoreData(userId, storeId) {
      return (isAuthenticated() && userId == request.auth.uid) || isActiveStoreMember(userId, storeId);
    }

    // Mirrors utils/category-access.ts#canStaffAccessCategory. Open until the owner picks
    // departments; then those departments, plus anyone named in `allowedStaff`.
    function categoryOpenToMember(folder, departmentId) {
      return folder.get('allowedDepartments', []).size() == 0 ||
        departmentId in folder.get('allowedDepartments', []) ||
        request.auth.uid in folder.get('allowedStaff', []);
    }

    function listOrEmpty(value) {
      return value == null ? [] : value;
    }

    function categoryAccessUnchanged() {
      return listOrEmpty(request.resource.data.get('allowedDepartments', [])) ==
               listOrEmpty(resource.data.get('allowedDepartments', [])) &&
             listOrEmpty(request.resource.data.get('allowedStaff', [])) ==
               listOrEmpty(resource.data.get('allowedStaff', []));
    }

    // Products whose category is gone stay readable to every member. Callers must pass
    // resource.data.folderId with no default: a default would let a query without a
    // folderId == X filter through unchecked.
    function memberCanOpenCategory(userId, storeId, folderId) {
      return !exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/inventoryFolders/$(folderId)) ||
        categoryOpenToMember(
          get(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/inventoryFolders/$(folderId)).data,
          memberData(userId, storeId).get('departmentId', '')
        );
    }

    // Elevated ops outside a dedicated permission module (customers, notifications): owner, or a
    // member with any manage grant. Dedicated modules (buybacks, seller loans, leads, multi-store)
    // use memberHasPermission() directly.
    function canManageNonInventoryOps(userId, storeId) {
      return isStoreOwnerForPath(userId) || memberHasAnyManage(userId, storeId);
    }

    function canAccessBuybacks(userId, storeId, action) {
      return isStoreOwnerForPath(userId) || memberHasPermission(userId, storeId, 'buybacks', action);
    }

    // Stock loans: every active store member can view/create/edit (baseline, like POS sales).
    // Delete stays on the explicit sellerLoans.delete grant.
    function canAccessSellerLoans(userId, storeId, action) {
      return isStoreOwnerForPath(userId)
        || (isActiveStoreMember(userId, storeId)
            && (action == 'view' || action == 'create' || action == 'edit'))
        || memberHasPermission(userId, storeId, 'sellerLoans', action);
    }

    function canAccessLeads(userId, storeId, action) {
      return isStoreOwnerForPath(userId) || memberHasPermission(userId, storeId, 'leads', action);
    }

    function canAccessMultiStore(userId, storeId, action) {
      return isStoreOwnerForPath(userId) || memberHasPermission(userId, storeId, 'multiStoreSync', action);
    }

    // Create new receipts (POS): owner, or any active store member. receipts.create defaults
    // true for every staff member (see deriveDefaultPermissions), same as it always has.
    function canCreateReceipt(userId, storeId) {
      return isStoreOwnerForPath(userId) || isActiveStoreMember(userId, storeId);
    }

    // Per-action products (inventory folders/items) grant check.
    function canManageProducts(userId, storeId, action) {
      return (isStoreOwnerForPath(userId) && ownsStore(userId, storeId)) ||
        memberHasPermission(userId, storeId, 'products', action);
    }

    // Undifferentiated "can manage products at all". kept for collections (customer buybacks)
    // that don't need per-action granularity.
    function canManageInventoryStructure(userId, storeId) {
      return (isStoreOwnerForPath(userId) && ownsStore(userId, storeId)) ||
        memberHasAnyProductsManage(userId, storeId);
    }



    // Partner loans (server-written): `sellerLoanOutId: trade~<loan>`. While a row is lent to a
    // partner the client may edit its details but not lend, sell, hold or free it, and may never
    // set the flag itself. Only the server settles partner loans.
    function onPartnerLoan(data) {
      return data.get('sellerLoanOutId', '') is string
        && data.get('sellerLoanOutId', '').matches('trade~.*');
    }

    function partnerLoanUntouched() {
      return (!onPartnerLoan(resource.data) && !onPartnerLoan(request.resource.data))
        || (onPartnerLoan(resource.data)
            && request.resource.data.get('sellerLoanOutId', null) == resource.data.get('sellerLoanOutId', null)
            && request.resource.data.get('dateOut', null) == resource.data.get('dateOut', null)
            && request.resource.data.get('pendingSaleReceiptId', null) == resource.data.get('pendingSaleReceiptId', null));
    }





    // Payments V2: money fields on a receipt freeze once the server has written paymentSummary
    // (i.e. any V2 payment exists). After that only server routes change what is owed or paid.
    function receiptMoneyLockedKeys() {
      return ['total', 'items', 'itemIds', 'itemsCount', 'discountReason', 'discountAmount',
              'swapInCredit', 'commissionAmount', 'splitPayments', 'currency', 'taxAmount',
              'taxRate', 'deliveryFee', 'customerName', 'customerEmail', 'customerPhone',
              'customerAddress', 'customerId', 'amountPaid', 'balanceDue', 'payments',
              'paymentMethod', 'status'];
    }

    function receiptClientUpdateKeepsPaymentsSafe() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['paymentSummary'])
        && (!('paymentSummary' in resource.data) || !changed.hasAny(receiptMoneyLockedKeys()));
    }

    function canViewPayments(userId, storeId) {
      return isStoreOwnerForPath(userId)
        || memberHasPermission(userId, storeId, 'payments', 'view')
        || memberHasPermission(userId, storeId, 'payments', 'confirm');
    }

    // Legacy name kept for a few rules; prefer the helpers above.
    function canManageStoreData(userId, storeId) {
      return canManageNonInventoryOps(userId, storeId);
    }

    // Backward-compat: older docs may not include storeId yet.
    function resourceMatchesStore(storeId) {
      return !resource.data.keys().hasAny(['storeId']) || resource.data.storeId == storeId;
    }

    function requestMatchesStore(storeId) {
      return !request.resource.data.keys().hasAny(['storeId']) || request.resource.data.storeId == storeId;
    }

    function userSelfServiceUpdateKeys() {
      return [
        'name',
        'email',
        'photoURL',
        'storeLogoUrl',
        'storeDetails',
        'preferences',
        'hasCompletedOnboarding',
        'hasCompletedTutorial',
        'updatedAt',
        'activationFunnel',
        'growthFeedback',
        'backupPreferences',
      ];
    }

    function userSelfServiceCreateKeys() {
      return userSelfServiceUpdateKeys().concat(['uid', 'role', 'subscription', 'createdAt']);
    }

    // A new account may only start as an owner on the free plan; paid plans come from the server.
    function userSelfServiceCreateValuesAllowed() {
      let data = request.resource.data;
      return data.get('role', 'superAdmin') == 'superAdmin'
        && data.get('subscription', 'storvv_micro') == 'storvv_micro'
        // createdAt must be the server's clock: the trial is offered to young accounts only.
        && data.get('createdAt', request.time) == request.time;
    }

    function userSelfServiceUpdateAllowed() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(userSelfServiceUpdateKeys())
        && !changed.hasAny([
          'role',
          'subscription',
          'subscriptionBillingCycle',
          'subscriptionUpdatedAt',
          'subscriptionStatus',
          'subscriptionCurrentPeriodEnd',
          'subscriptionAddOns',
          'paystackSubscriptionCode',
          'paystackSubscriptionEmailToken',
          'paystackCustomerCode',
          'lastPaystackReference',
          'twoFactorSecret',
          'twoFactorEnabled',
          'twoFactorMethod',
          'twoFactorEnabledAt',
          'uid',
          'createdAt',
          'mustChangePassword',
          'trialEndsAt',
        ]);
    }
    
    // Users collection - owner only. The doc holds billing references (and, on accounts that
    // enabled 2FA before the security/ subcollection, a legacy twoFactorSecret), so staff get the
    // fields they inherit (plan, preferences, store details) from /api/workspace/owner-context.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userSelfServiceCreateKeys())
        && userSelfServiceCreateValuesAllowed();
      
      allow update: if isOwner(userId) && userSelfServiceUpdateAllowed();
      
      // Never from the client: deleting and recreating the doc would clear trialEndsAt and
      // reset createdAt, granting a fresh free trial. Account removal goes through the server.
      allow delete: if false;

      match /workspaceMembers/{memberUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == memberUid);
        allow create, update, delete: if isOwner(userId);
      }

      match /security/{docId} {
        allow read, write: if false;
      }

      match /pendingCheckouts/{checkoutId} {
        allow read, write: if false;
      }

      // Billing server only: one doc per applied Paystack charge reference (replay guard).
      match /subscriptionCharges/{reference} {
        allow read, write: if false;
      }

      // Billing server only; the owner reads the summary on users/{userId}.subscriptionAddOns.
      match /subscriptionAddOns/{addOnId} {
        allow read, write: if false;
      }

      // Customer rewards: written and read only by the server (/api/loyalty/*), so points
      // cannot be granted or edited from the app.
      match /loyalty/{docId} {
        allow read, write: if false;
      }
      match /loyaltyMembers/{customerKey} {
        allow read, write: if false;
      }
      match /loyaltyAwards/{awardId} {
        allow read, write: if false;
      }
      match /loyaltyLedger/{entryId} {
        allow read, write: if false;
      }
      
      // Store transfers subcollection: users/{userId}/storeTransfers/{transferId}
      // This collection stores transfer history for multi-store operations
      match /storeTransfers/{transferId} {
        allow read: if planIsEnterprise(userId) && (
                       isStoreOwnerForPath(userId) ||
                       (resource.data.keys().hasAny(['sourceStoreId']) &&
                         canAccessMultiStore(userId, resource.data.sourceStoreId, 'view')) ||
                       (resource.data.keys().hasAny(['destinationStoreId']) &&
                         canAccessMultiStore(userId, resource.data.destinationStoreId, 'view')) ||
                       (resource.data.keys().hasAny(['fromStoreId']) &&
                         canAccessMultiStore(userId, resource.data.fromStoreId, 'view')) ||
                       (resource.data.keys().hasAny(['toStoreId']) &&
                         canAccessMultiStore(userId, resource.data.toStoreId, 'view'))
                     );
        
        allow create: if planIsEnterprise(userId) &&
                       request.resource.data.createdBy == request.auth.uid &&
                       (
                         isStoreOwnerForPath(userId) ||
                         (request.resource.data.keys().hasAny(['sourceStoreId']) &&
                           canAccessMultiStore(userId, request.resource.data.sourceStoreId, 'create')) ||
                         (request.resource.data.keys().hasAny(['fromStoreId']) &&
                           canAccessMultiStore(userId, request.resource.data.fromStoreId, 'create'))
                       );
        
        allow update, delete: if planIsEnterprise(userId) && (
                       isStoreOwnerForPath(userId) ||
                       (resource.data.keys().hasAny(['sourceStoreId']) &&
                         canAccessMultiStore(userId, resource.data.sourceStoreId, 'edit')) ||
                       (resource.data.keys().hasAny(['destinationStoreId']) &&
                         canAccessMultiStore(userId, resource.data.destinationStoreId, 'edit')) ||
                       (resource.data.keys().hasAny(['fromStoreId']) &&
                         canAccessMultiStore(userId, resource.data.fromStoreId, 'edit')) ||
                       (resource.data.keys().hasAny(['toStoreId']) &&
                         canAccessMultiStore(userId, resource.data.toStoreId, 'edit'))
                     );
      }
      
      // Store syncs subcollection: users/{userId}/storeSyncs/{syncId}
      // This collection stores sync history for multi-store operations
      match /storeSyncs/{syncId} {
        allow read: if planIsEnterprise(userId) && (
                       isStoreOwnerForPath(userId) ||
                       (resource.data.keys().hasAny(['sourceStoreId']) &&
                         canAccessMultiStore(userId, resource.data.sourceStoreId, 'view')) ||
                       (resource.data.keys().hasAny(['destinationStoreId']) &&
                         canAccessMultiStore(userId, resource.data.destinationStoreId, 'view'))
                     );
        
        allow create: if planIsEnterprise(userId) &&
                       request.resource.data.createdBy == request.auth.uid &&
                       (
                         isStoreOwnerForPath(userId) ||
                         (request.resource.data.keys().hasAny(['sourceStoreId']) &&
                           canAccessMultiStore(userId, request.resource.data.sourceStoreId, 'create'))
                       );
        
        allow update, delete: if planIsEnterprise(userId) && (
                       isStoreOwnerForPath(userId) ||
                       (resource.data.keys().hasAny(['sourceStoreId']) &&
                         canAccessMultiStore(userId, resource.data.sourceStoreId, 'edit')) ||
                       (resource.data.keys().hasAny(['destinationStoreId']) &&
                         canAccessMultiStore(userId, resource.data.destinationStoreId, 'edit'))
                     );
      }
      
      // Stores subcollection: users/{userId}/stores/{storeId}
      match /stores/{storeId} {
        // Allow read if:
        // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
        // 2. User owns the store (ownerId matches auth.uid)
        // 3. Staff member belongs to this store
        // Note: The exists() check allows staff to query stores to find where they belong
        allow read: if canAccessStoreData(userId, storeId) ||
                     (planIsEnterprise(userId) && isActiveWorkspaceAdmin(userId));
        
        // Created only by POST /api/workspace/stores/create, which checks the plan's branch limit
        // and stamps `planTier` (a client-made branch with no tier would count as within plan).
        allow create: if false;
        
        // Allow update/delete if user is the super admin (userId in path) who owns the store.
        // `planTier` is server-written (see planAllowsStoreWrite).
        allow update: if ownsStore(userId, storeId) && planTierUnchanged();
        allow delete: if ownsStore(userId, storeId);

        // Store members subcollection: users/{userId}/stores/{storeId}/members/{memberUid}
        // This is the canonical access-control index for rule checks.
        match /members/{memberUid} {
          // Store owner can read/write all members; a branch admin reads them. A member can read
          // their own membership doc. `admin` / `adminGrants` are owner-only like everything here.
          allow read: if ownsStore(userId, storeId) || isStoreAdmin(userId, storeId) ||
                       (isAuthenticated() && request.auth.uid == memberUid);
          // Payments grants (permissions.payments) are server-only so every grant is audit-logged.
          // `planTier` is server-written too (see planAllowsStoreWrite).
          // Written only by the staff routes and the plan-tier sync, which enforce the plan's staff
          // limit; a client-made membership would add a full-access staff member for free.
          allow create, update, delete: if false;
        }
        
        // Departments subcollection: users/{userId}/stores/{storeId}/departments/{departmentId}
        match /departments/{departmentId} {
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
          // 2. Department was created by the current user
          // 3. Staff member belongs to this department
          allow read: if isAuthenticated() && 
                       (userId == request.auth.uid || 
                        resource.data.createdBy == request.auth.uid || 
                        isStoreAdmin(userId, storeId) ||
                        exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/$(departmentId)/staff/$(request.auth.uid)));
          
          // Create/update/delete: the owner, or a branch admin. Departments always stay
          // owned by the store owner (`userId` / `createdBy`), whoever writes them.
          allow create: if planAllowsStoreWrite(userId, storeId) && (isAuthenticated() && 
                         (userId == request.auth.uid || isStoreAdmin(userId, storeId)) &&
                         request.resource.data.createdBy == userId &&
                         request.resource.data.get('userId', userId) == userId);
          
          allow update: if planAllowsStoreWrite(userId, storeId) && (isAuthenticated() && 
                         (userId == request.auth.uid || isStoreAdmin(userId, storeId)) &&
                         resource.data.createdBy == userId &&
                         request.resource.data.createdBy == userId &&
                         request.resource.data.get('userId', userId) == userId);
          
          allow delete: if planAllowsStoreWrite(userId, storeId) && (isAuthenticated() && 
                         (userId == request.auth.uid || isStoreAdmin(userId, storeId)) &&
                         resource.data.createdBy == userId);
          
          // Staff subcollection: users/{userId}/stores/{storeId}/departments/{departmentId}/staff/{staffId}
          match /staff/{staffId} {
            // Helper function to check if this is the staff member's own document
            function isOwnStaffDocument() {
              return resource.data.authUid == request.auth.uid
            }
            
            // Allow read (both get and list) if:
            // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
            // 2. Staff member was created by the current user  
            // 3. It's the staff member's own document (for staff login)
            //
            // CRITICAL: For collection queries, Firestore evaluates this rule for each document.
            // When a staff member queries with where('authUid', '==', request.auth.uid), Firestore
            // will only return documents where isOwnStaffDocument() is true, even if userId doesn't match.
            // The OR condition allows the query to proceed, and Firestore filters results automatically.
            // Ownership comes from the path, never from `createdBy`: staff must not be able to
            // point their record at another workspace (owner-context trusted it).
            allow read: if isAuthenticated() &&
                         (userId == request.auth.uid || isOwnStaffDocument() ||
                          isStoreAdmin(userId, storeId));

            // Created only by POST /api/staff/create, which also creates the login. `authUid` is
            // never set or changed by a client: it would point the record at another business's login.
            allow create: if false;

            // Owner: any field. Staff on their own record: photo, and clearing mustChangePassword.
            allow update: if isAuthenticated() &&
                           request.resource.data.get('authUid', null) == resource.data.get('authUid', null) &&
                           (userId == request.auth.uid ||
                            (isOwnStaffDocument() &&
                             request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['photoURL', 'mustChangePassword', 'updatedAt']) &&
                             (!request.resource.data.diff(resource.data).affectedKeys()
                                 .hasAny(['mustChangePassword']) ||
                              request.resource.data.get('mustChangePassword', false) == false)));
            
            // Allow delete if user is the super admin (userId in path) who created the staff member
            allow delete: if isAuthenticated() && 
                           userId == request.auth.uid && 
                           resource.data.createdBy == request.auth.uid;
          }
        }
        
        // Inventory folders subcollection: users/{userId}/stores/{storeId}/inventoryFolders/{folderId}
        match /inventoryFolders/{folderId} {
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
          // 2. User created the folder (createdBy matches auth.uid)
          // 3. Staff member accessing their superadmin's store (userId != auth.uid means staff, and getQueryUserId ensures correct store)
          // 4. Enterprise branch admin picking a destination category on another branch
          // Note: For staff, the userId in path is their superadmin's UID (via getQueryUserId), so staff can read their store's inventory
          allow read: if canAccessStoreData(userId, storeId) ||
                       (planIsEnterprise(userId) && isActiveWorkspaceAdmin(userId));
          
          // Create/update/delete: owner, or a member granted the matching products action.
          allow create: if planAllowsStoreWrite(userId, storeId) && (canManageProducts(userId, storeId, 'create') &&
                         request.resource.data.storeId == storeId);

          // Who can open a category is the owner's call: members with products.edit can change
          // everything else, but must leave allowedDepartments / allowedStaff as they were.
          allow update: if planAllowsStoreWrite(userId, storeId) && (canManageProducts(userId, storeId, 'edit') &&
                         resourceMatchesStore(storeId) &&
                         requestMatchesStore(storeId) &&
                         (ownsStore(userId, storeId) || categoryAccessUnchanged()));

          allow delete: if planAllowsStoreWrite(userId, storeId) && (canManageProducts(userId, storeId, 'delete') &&
                         resourceMatchesStore(storeId));
        }
        
        // Inventory items subcollection: users/{userId}/stores/{storeId}/inventoryItems/{itemId}
        match /inventoryItems/{itemId} {
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
          // 2. Store member, for products in categories open to them (see memberCanOpenCategory).
          //    Writes are not gated on the category so refunds and transfers of locked stock work.
          // 3. Enterprise branch admin completing a transfer that touches another branch
          allow read: if (isAuthenticated() && userId == request.auth.uid) ||
                       (isActiveStoreMember(userId, storeId) &&
                        memberCanOpenCategory(userId, storeId, resource.data.folderId)) ||
                       (planIsEnterprise(userId) && isActiveWorkspaceAdmin(userId));
          
          // Full create/delete: owner, or a member granted the matching products action.
          // Trade-in items are created by the sale route (POST /api/sales/create), not clients.
          // Enterprise branch admins may also create/update/delete items when completing a transfer.
          allow create: if planAllowsStoreWrite(userId, storeId) && ((canManageProducts(userId, storeId, 'create') ||
                          (planIsEnterprise(userId) && isActiveWorkspaceAdmin(userId))) &&
                         request.resource.data.storeId == storeId &&
                         !onPartnerLoan(request.resource.data));

          // Update: owner or products.edit grant (and transfer admins). Selling, refunding, holding
          // and lending stock are server routes (server/api/sales, server/api/stock-loans), so
          // other members can no longer mark items sold or unsold without a sale behind it.
          allow update: if planAllowsStoreWrite(userId, storeId) && (partnerLoanUntouched() && (
                        (canManageProducts(userId, storeId, 'edit') &&
                         resourceMatchesStore(storeId) &&
                         requestMatchesStore(storeId)) ||
                        (planIsEnterprise(userId) && isActiveWorkspaceAdmin(userId) &&
                         resourceMatchesStore(storeId) &&
                         requestMatchesStore(storeId))));

          allow delete: if planAllowsStoreWrite(userId, storeId) && ((canManageProducts(userId, storeId, 'delete') ||
                          (planIsEnterprise(userId) && isActiveWorkspaceAdmin(userId))) &&
                         resourceMatchesStore(storeId) &&
                         !onPartnerLoan(resource.data));
        }
        
        // Receipts subcollection: users/{userId}/stores/{storeId}/receipts/{receiptId}
        match /receipts/{receiptId} {
          // Allow read to store owner and active members.
          allow read: if canAccessStoreData(userId, storeId) &&
                       resourceMatchesStore(storeId);
          
          // Sales are recorded by POST /api/sales/create, which prices them from inventory, checks
          // discounts and trade-ins, and moves stock in the same transaction; balance payments,
          // cancels and refunds are server routes too. Full update stays with the owner and
          // receipts.edit holders (managers correcting a sale).
          allow create: if false;

          allow update: if planAllowsStoreWrite(userId, storeId) && (receiptClientUpdateKeepsPaymentsSafe() &&
                        request.resource.data.get('tradeLoanId', null) == resource.data.get('tradeLoanId', null) && (
                        ((isStoreOwnerForPath(userId) || memberHasPermission(userId, storeId, 'receipts', 'edit')) &&
                         resourceMatchesStore(storeId) &&
                         requestMatchesStore(storeId))));

          allow delete: if planAllowsStoreWrite(userId, storeId) && ((ownsStore(userId, storeId) ||
                          storeAdminHasGrant(userId, storeId, 'deleteSales')) &&
                         resourceMatchesStore(storeId) &&
                         !('paymentSummary' in resource.data));
        }

        // Payments V2 records: written only by server routes (Admin SDK). The recorder may read
        // their own entries; owners and payments.view/confirm holders read all.
        match /payments/{paymentId} {
          allow read: if canViewPayments(userId, storeId) ||
                       (isActiveStoreMember(userId, storeId) &&
                        resource.data.recordedBy == request.auth.uid);
          allow write: if false;
        }

        // Append-only payment audit events (tamper-evident hash chain) and its chain head.
        match /paymentEvents/{eventId} {
          allow read: if canViewPayments(userId, storeId);
          allow write: if false;
        }

        match /paymentAudit/{docId} {
          allow read: if isStoreOwnerForPath(userId);
          allow write: if false;
        }

        // Payments V2 settings (cash confirmation mode, tender kinds): server writes, owner only.
        match /paymentConfig/{docId} {
          allow read: if isStoreOwnerForPath(userId) || isActiveStoreMember(userId, storeId);
          allow write: if false;
        }

        // End-of-day cash counts.
        match /tillCounts/{countId} {
          allow read: if canViewPayments(userId, storeId);
          allow write: if false;
        }
        
        // Customers subcollection: users/{userId}/stores/{storeId}/customers/{customerId}
        // Loan inventory to external seller / retailer (tracked; not marked sold until receipt).
        match /sellerLoanOuts/{loanId} {
          allow read: if planIsEnterprise(userId) &&
                         canAccessSellerLoans(userId, storeId, 'view') &&
                         resourceMatchesStore(storeId);

          // Loans and their items change together on the server (server/api/stock-loans), which
          // checks each item is free and only lets managers mark loaned stock as sold.
          allow create, update: if false;

          allow delete: if false;
        }

        // Customer buybacks: store buys items from customers into inventory.
        match /customerBuybacks/{buybackId} {
          allow read: if canAccessBuybacks(userId, storeId, 'view') &&
                         resourceMatchesStore(storeId);

          allow create: if planAllowsStoreWrite(userId, storeId) && (canAccessBuybacks(userId, storeId, 'create') &&
                           request.resource.data.storeId == storeId &&
                           request.resource.data.createdBy == request.auth.uid &&
                           request.resource.data.status == 'completed' &&
                           request.resource.data.inventoryItemId is string &&
                           request.resource.data.folderId is string &&
                           request.resource.data.purchasePrice is number &&
                           request.resource.data.purchasePrice > 0);

          allow update: if planAllowsStoreWrite(userId, storeId) && (canAccessBuybacks(userId, storeId, 'edit') &&
                           resourceMatchesStore(storeId) &&
                           requestMatchesStore(storeId));

          allow delete: if false;
        }

        // Sales leads: manual enquiry tracking (no external messaging APIs).
        match /salesLeads/{leadId} {
          allow read: if planAtLeastMedium(userId) &&
                         canAccessLeads(userId, storeId, 'view') &&
                         resourceMatchesStore(storeId);

          allow create: if planAllowsStoreWrite(userId, storeId) && (planAtLeastMedium(userId) &&
                           canAccessLeads(userId, storeId, 'create') &&
                           request.resource.data.storeId == storeId &&
                           request.resource.data.createdBy == request.auth.uid &&
                           request.resource.data.status == 'new' &&
                           request.resource.data.customerName is string &&
                           request.resource.data.productName is string &&
                           request.resource.data.source is string);

          allow update: if planAllowsStoreWrite(userId, storeId) && (planAtLeastMedium(userId) &&
                           canAccessLeads(userId, storeId, 'edit') &&
                           resourceMatchesStore(storeId) &&
                           requestMatchesStore(storeId));

          allow delete: if planAllowsStoreWrite(userId, storeId) && (planAtLeastMedium(userId) &&
                           canAccessLeads(userId, storeId, 'delete') &&
                           resourceMatchesStore(storeId));
        }

        match /leadEvents/{eventId} {
          allow read: if planAtLeastMedium(userId) &&
                         canAccessStoreData(userId, storeId) &&
                         resourceMatchesStore(storeId);

          allow create: if planAllowsStoreWrite(userId, storeId) && (planAtLeastMedium(userId) &&
                           canCreateReceipt(userId, storeId) &&
                           request.resource.data.storeId == storeId &&
                           request.resource.data.createdBy == request.auth.uid &&
                           request.resource.data.leadId is string &&
                           request.resource.data.type is string &&
                           request.resource.data.description is string);

          allow update, delete: if false;
        }

        match /customers/{customerId} {
          allow read: if canAccessStoreData(userId, storeId);
          
          // Any active member can upsert from POS; delete stays elevated-ops only.
          allow create: if planAllowsStoreWrite(userId, storeId) && (isStoreOwnerForPath(userId) || isActiveStoreMember(userId, storeId));
          allow update: if planAllowsStoreWrite(userId, storeId) && (isStoreOwnerForPath(userId) || isActiveStoreMember(userId, storeId));
          allow delete: if planAllowsStoreWrite(userId, storeId) && (canManageNonInventoryOps(userId, storeId));
        }

        // Customer balance / credit ledger (Medium+ in product; rules allow all store roles to record payments).
        match /customerAccounts/{accountId} {
          allow read: if planAtLeastMedium(userId) && canAccessStoreData(userId, storeId);
          // Entries go through POST /api/customer-accounts/entry, which works out the balance and
          // records who made each entry; members could otherwise wipe a debt.
          allow create, update: if false;
          allow delete: if planAllowsStoreWrite(userId, storeId) && (planAtLeastMedium(userId) && canManageNonInventoryOps(userId, storeId));
        }
        
        // Notifications subcollection: users/{userId}/stores/{storeId}/notifications/{notificationId}
        match /notifications/{notificationId} {
          allow read: if canAccessStoreData(userId, storeId);
          
          // Payments V2, trade and sale notifications are server-written; a client must not forge them.
          allow create: if planAllowsStoreWrite(userId, storeId) && (canCreateReceipt(userId, storeId)
            && !(request.resource.data.get('source', '') in ['payments_v2', 'trade', 'server'])
            && !request.resource.data.get('type', '').matches('^(payment_|payout_|till_count_|trade_|swap_in_|offline_sale_).*')
            && request.resource.data.get('type', '') != 'receipt_created'
            && !('recipientUids' in request.resource.data));
          allow update: if (planAllowsStoreWrite(userId, storeId) && canManageNonInventoryOps(userId, storeId))
            || (canAccessStoreData(userId, storeId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                && request.resource.data.read == true);
          allow delete: if isAuthenticated() && userId == request.auth.uid;
        }
        
        // Activity logs subcollection: users/{userId}/stores/{storeId}/activityLogs/{logId}
        // Security audit trail (who changed what in inventory)
        match /activityLogs/{logId} {
          allow read: if planAtLeastMedium(userId) && canAccessStoreData(userId, storeId);
          // Entries marked `source: 'server'` (sales, refunds) are written by the Admin SDK only, so
          // a client can't forge one that looks like the system's own record.
          allow create: if planAtLeastMedium(userId) &&
                         (isStoreOwnerForPath(userId) || isActiveStoreMember(userId, storeId)) &&
                         request.resource.data.storeId == storeId &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.get('source', '') != 'server';
          allow update, delete: if false;
        }

        // Price/name audit for all plans (Micro included)
        match /inventoryAuditLogs/{logId} {
          allow read: if canAccessStoreData(userId, storeId);
          allow create: if canAccessStoreData(userId, storeId) &&
                         request.resource.data.storeId == storeId &&
                         request.resource.data.userId == request.auth.uid;
          allow update, delete: if false;
        }

        // Private storefront settings (business only). Public catalogue is top-level storefronts/*.
        match /storefrontConfig/{docId} {
          allow read: if canAccessStoreData(userId, storeId);
          allow create, update: if planAllowsStoreWrite(userId, storeId) && (isStoreOwnerForPath(userId) ||
            memberHasAnyProductsManage(userId, storeId));
          allow delete: if planAllowsStoreWrite(userId, storeId) && (isStoreOwnerForPath(userId));
        }

        // Guest inquiries / reservations. client read for staff; writes via Admin SDK only.
        match /storefrontInquiries/{inquiryId} {
          allow read: if canAccessStoreData(userId, storeId);
          allow create, update, delete: if false;
        }

        // Aggregate public view counts. staff read; Admin SDK writes only.
        match /storefrontAnalytics/{docId} {
          allow read: if canAccessStoreData(userId, storeId);
          allow create, update, delete: if false;
        }
      }
    }

    // ── Public storefront projections (anonymous read; business write) ──
    function requestStorefrontOwnerUid() {
      return request.resource.data.ownerUid;
    }
    function requestStorefrontStoreId() {
      return request.resource.data.storeId;
    }
    function canWriteStorefrontProjection(ownerUid, storeId) {
      return isAuthenticated() &&
             ownerUid is string &&
             storeId is string &&
             (isStoreOwnerForPath(ownerUid) || memberHasAnyProductsManage(ownerUid, storeId));
    }

    match /storefronts/{slug} {
      // Public catalogue: published profiles are world-readable.
      // Owners/managers can always read their own docs (incl. unpublished).
      // Note: getDoc on a *missing* doc still fails if rules touch resource.data -
      // callers must soft-catch permission-denied for existence checks.
      allow read: if resource.data.isPublished == true
                  || (isAuthenticated()
                      && resource.data.ownerUid is string
                      && resource.data.storeId is string
                      && (resource.data.ownerUid == request.auth.uid
                          || memberHasAnyProductsManage(resource.data.ownerUid, resource.data.storeId)));
      allow create: if canWriteStorefrontProjection(requestStorefrontOwnerUid(), requestStorefrontStoreId())
                    && request.resource.data.slug == slug
                    && request.resource.data.ownerUid is string
                    && request.resource.data.storeId is string;
      allow update: if canWriteStorefrontProjection(resource.data.ownerUid, resource.data.storeId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.storeId == resource.data.storeId
                    && request.resource.data.slug == slug;
      allow delete: if canWriteStorefrontProjection(resource.data.ownerUid, resource.data.storeId);
    }

    // A listing may only sit under a storefront owned by the same owner and store.
    function storefrontIsFor(slug, ownerUid, storeId) {
      let path = /databases/$(database)/documents/storefronts/$(slug);
      return exists(path)
             && get(path).data.ownerUid == ownerUid
             && get(path).data.storeId == storeId;
    }
    function canWriteStorefrontSlug(slug) {
      let path = /databases/$(database)/documents/storefronts/$(slug);
      return exists(path)
             && canWriteStorefrontProjection(get(path).data.ownerUid, get(path).data.storeId);
    }

    match /storefrontListings/{slug}/items/{itemId} {
      allow read: if (resource.data.isListed == true
                      && exists(/databases/$(database)/documents/storefronts/$(slug))
                      && get(/databases/$(database)/documents/storefronts/$(slug)).data.isPublished == true)
                  || (isAuthenticated()
                      && resource.data.ownerUid is string
                      && resource.data.storeId is string
                      && canWriteStorefrontProjection(resource.data.ownerUid, resource.data.storeId));
      allow create: if canWriteStorefrontProjection(requestStorefrontOwnerUid(), requestStorefrontStoreId())
                    && storefrontIsFor(slug, requestStorefrontOwnerUid(), requestStorefrontStoreId())
                    && request.resource.data.id == itemId;
      allow update: if canWriteStorefrontProjection(resource.data.ownerUid, resource.data.storeId)
                    && storefrontIsFor(slug, resource.data.ownerUid, resource.data.storeId)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.storeId == resource.data.storeId;
      // The listing's writer, or the storefront's owner (to clear items placed by anyone else).
      allow delete: if canWriteStorefrontProjection(resource.data.ownerUid, resource.data.storeId)
                    || canWriteStorefrontSlug(slug);
    }
    
    // Legacy collections - keep for backward compatibility during migration
    // These will be removed after migration is complete
    match /stores/{storeId} {
      allow read, write: if false; // Deny all access to legacy stores collection
    }
    
    match /departments/{departmentId} {
      allow read, write: if false; // Deny all access to legacy departments collection
    }
    
    match /staff/{staffId} {
      allow read, write: if false; // Deny all access to legacy staff collection
    }
    
    match /inventoryFolders/{folderId} {
      allow read, write: if false; // Deny all access to legacy inventoryFolders collection
    }
    
    match /inventoryItems/{itemId} {
      allow read, write: if false; // Deny all access to legacy inventoryItems collection
    }
    
    match /receipts/{receiptId} {
      allow read, write: if false; // Deny all access to legacy receipts collection
    }
    
    match /customers/{customerId} {
      allow read, write: if false; // Deny all access to legacy customers collection
    }
    
    match /notifications/{notificationId} {
      allow read, write: if false; // Deny all access to legacy notifications collection
    }

    // Payments V2 server-only collections (Admin SDK). Listed explicitly so tests pin them.
    match /paymentLinksV2/{document=**} {
      allow read, write: if false;
    }

    match /paymentLinkTokens/{tokenHash} {
      allow read, write: if false;
    }

    match /paystackEvents/{eventId} {
      allow read, write: if false;
    }

    match /paymentAuditAnchors/{anchorId} {
      allow read, write: if false;
    }

    match /paymentsOpsAlerts/{alertId} {
      allow read, write: if false;
    }

    // Trade partners: server-only (Admin SDK); each side reads its view through /api/trade.
    match /tradeProfiles/{storeKey} {
      allow read, write: if false;
    }

    match /tradeHandles/{handle} {
      allow read, write: if false;
    }

    match /tradeConnections/{connectionId} {
      allow read, write: if false;
    }

    match /tradeRequests/{requestId} {
      allow read, write: if false;
    }

    match /tradeSales/{saleId} {
      allow read, write: if false;
    }

    match /tradeLoans/{loanId} {
      allow read, write: if false;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}