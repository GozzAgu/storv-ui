rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - users can read/write their own document
    match /users/{userId} {
      // Allow read if user is authenticated
      allow read: if isAuthenticated();
      
      // Allow create if user is creating their own document
      allow create: if isOwner(userId);
      
      // Allow update if user is updating their own document
      allow update: if isOwner(userId);
      
      // Only allow delete by the document owner
      allow delete: if isOwner(userId);
    }
    
    // Departments collection - users can only access their own departments
    match /departments/{departmentId} {
      // Allow read if user owns the department
      allow read: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      
      // Allow create if user is creating their own department
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      
      // Allow update if user owns the department
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      
      // Allow delete if user owns the department
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
    
    // Staff collection - users can only access their own staff
    match /staff/{staffId} {
      // Allow read if user owns the staff member
      allow read: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      
      // Allow create if user is creating their own staff member
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      
      // Allow update if user owns the staff member
      allow update: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      
      // Allow delete if user owns the staff member
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

