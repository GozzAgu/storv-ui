rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Collection group queries for staff - allows searching across all staff collections
    // This is used when staff members need to find their own documents
    // IMPORTANT: For collection group queries, Firestore evaluates the query against potential results
    // The query where('authUid', '==', request.auth.uid) must only match documents where
    // resource.data.authUid == request.auth.uid is true. This rule ensures that.
    // The {path=**} pattern matches any path, allowing collection group queries across all stores
    // This rule MUST come before the nested staff rules to ensure collection group queries work
    match /{path=**}/staff/{staffId} {
      // Allow read (covers both get and list/collection group operations) if:
      // 1. User is authenticated
      // 2. The document's authUid matches the authenticated user's UID
      // This allows staff members to find their own documents via collection group queries
      // When querying with where('authUid', '==', request.auth.uid), Firestore will only
      // return documents where this condition evaluates to true
      // 
      // NOTE: If authUid is missing or null, the comparison will fail (which is correct security)
      allow read: if isAuthenticated() && 
                   resource.data.authUid == request.auth.uid;
      
      // TEMPORARY DEBUG RULE (for testing only - REMOVE after debugging)
      // Uncomment the line below to temporarily allow all authenticated users to read staff
      // This helps confirm if the issue is authUid matching or something else
      // If this fixes it, then the problem is authUid field mismatch in your documents
      // allow read: if isAuthenticated();
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is staff member accessing their own store
    function isStaffMember(userId, storeId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/$(request.resource.data.departmentId)/staff/$(request.auth.uid));
    }
    
    // Users collection - users can read/write their own document
    match /users/{userId} {
      // Allow read if user is authenticated
      allow read: if isAuthenticated();
      
      // Allow create if user is creating their own document
      allow create: if isOwner(userId);
      
      // Allow update if user is updating their own document
      allow update: if isOwner(userId);
      
      // Only allow delete by the document owner
      allow delete: if isOwner(userId);
      
      // Stores subcollection: users/{userId}/stores/{storeId}
      match /stores/{storeId} {
        // Allow read if:
        // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
        // 2. User owns the store (ownerId matches auth.uid)
        // 3. Staff member belongs to this store
        // Note: The exists() check allows staff to query stores to find where they belong
        allow read: if isAuthenticated() && 
                     (userId == request.auth.uid || 
                      resource.data.ownerId == request.auth.uid || 
                      exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)));
        
        // Allow create if user is the super admin (userId in path) creating store in their account
        allow create: if isAuthenticated() && 
                       userId == request.auth.uid && 
                       request.resource.data.ownerId == request.auth.uid;
        
        // Allow update/delete if user is the super admin (userId in path) who owns the store
        allow update, delete: if isAuthenticated() && 
                               userId == request.auth.uid && 
                               resource.data.ownerId == request.auth.uid;
        
        // Departments subcollection: users/{userId}/stores/{storeId}/departments/{departmentId}
        match /departments/{departmentId} {
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
          // 2. Department was created by the current user
          // 3. Staff member belongs to this department
          allow read: if isAuthenticated() && 
                       (userId == request.auth.uid || 
                        resource.data.createdBy == request.auth.uid || 
                        exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/$(departmentId)/staff/$(request.auth.uid)));
          
          // Allow create if user is the super admin (userId in path) creating department in their store
          allow create: if isAuthenticated() && 
                         userId == request.auth.uid && 
                         request.resource.data.createdBy == request.auth.uid;
          
          // Allow update if user is the super admin (userId in path) who created the department
          allow update: if isAuthenticated() && 
                         userId == request.auth.uid && 
                         resource.data.createdBy == request.auth.uid;
          
          // Allow delete if user is the super admin (userId in path) who created the department
          allow delete: if isAuthenticated() && 
                         userId == request.auth.uid && 
                         resource.data.createdBy == request.auth.uid;
          
          // Staff subcollection: users/{userId}/stores/{storeId}/departments/{departmentId}/staff/{staffId}
          match /staff/{staffId} {
            // Helper function to check if this is the staff member's own document
            function isOwnStaffDocument() {
              return resource.data.authUid == request.auth.uid
            }
            
            // Allow read (both get and list) if:
            // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
            // 2. Staff member was created by the current user  
            // 3. It's the staff member's own document (for staff login)
            //
            // CRITICAL: For collection queries, Firestore evaluates this rule for each document.
            // When a staff member queries with where('authUid', '==', request.auth.uid), Firestore
            // will only return documents where isOwnStaffDocument() is true, even if userId doesn't match.
            // The OR condition allows the query to proceed, and Firestore filters results automatically.
            allow read: if isAuthenticated() && 
                         (userId == request.auth.uid || 
                          resource.data.createdBy == request.auth.uid || 
                          isOwnStaffDocument());
            
            // Allow create if user is the super admin (userId in path) creating staff in their store
            allow create: if isAuthenticated() && 
                           userId == request.auth.uid && 
                           request.resource.data.createdBy == request.auth.uid;
            
            // Allow update if user is the super admin (userId in path) OR staff member updating their own document
            allow update: if isAuthenticated() && 
                           (userId == request.auth.uid || 
                            resource.data.createdBy == request.auth.uid ||
                            resource.data.authUid == request.auth.uid);
            
            // Allow delete if user is the super admin (userId in path) who created the staff member
            allow delete: if isAuthenticated() && 
                           userId == request.auth.uid && 
                           resource.data.createdBy == request.auth.uid;
          }
        }
        
        // Inventory folders subcollection: users/{userId}/stores/{storeId}/inventoryFolders/{folderId}
        match /inventoryFolders/{folderId} {
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
          // 2. User created the folder (createdBy matches auth.uid)
          // 3. Staff member accessing their superadmin's store (userId != auth.uid means staff, and getQueryUserId ensures correct store)
          // Note: For staff, the userId in path is their superadmin's UID (via getQueryUserId), so staff can read their store's inventory
          allow read: if isAuthenticated() && 
                       (userId == request.auth.uid || 
                        resource.data.createdBy == request.auth.uid ||
                        // Staff accessing their superadmin's store (userId is superadmin's UID from getQueryUserId)
                        request.auth.uid != userId);
          
          // Allow create if user is creating their own folder OR if staff member belongs to this store
          allow create: if isAuthenticated() && 
                         (request.resource.data.createdBy == request.auth.uid ||
                          userId == request.auth.uid ||
                          request.auth.uid != userId);
          
          // Allow update if user owns the folder OR if staff member belongs to this store
          allow update: if isAuthenticated() && 
                         (resource.data.createdBy == request.auth.uid ||
                          userId == request.auth.uid ||
                          request.auth.uid != userId);
          
          // Allow delete if user owns the folder OR if superadmin owns the store
          allow delete: if isAuthenticated() && 
                         (resource.data.createdBy == request.auth.uid ||
                          userId == request.auth.uid);
        }
        
        // Inventory items subcollection: users/{userId}/stores/{storeId}/inventoryItems/{itemId}
        match /inventoryItems/{itemId} {
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid) - allows collection queries
          // 2. User created the item (createdBy matches auth.uid)
          // 3. Staff member accessing their superadmin's store (userId != auth.uid means staff, and getQueryUserId ensures correct store)
          // Note: For staff, the userId in path is their superadmin's UID (via getQueryUserId), so staff can read their store's inventory
          allow read: if isAuthenticated() && 
                       (userId == request.auth.uid || 
                        resource.data.createdBy == request.auth.uid ||
                        // Staff accessing their superadmin's store (userId is superadmin's UID from getQueryUserId)
                        request.auth.uid != userId);
          
          // Allow create if user is creating their own item OR if staff member belongs to this store
          allow create: if isAuthenticated() && 
                         (request.resource.data.createdBy == request.auth.uid ||
                          userId == request.auth.uid ||
                          request.auth.uid != userId);
          
          // Allow update if user owns the item OR if staff member belongs to this store
          allow update: if isAuthenticated() && 
                         (resource.data.createdBy == request.auth.uid ||
                          userId == request.auth.uid ||
                          request.auth.uid != userId);
          
          // Allow delete if user owns the item OR if superadmin owns the store
          allow delete: if isAuthenticated() && 
                         (resource.data.createdBy == request.auth.uid ||
                          userId == request.auth.uid);
        }
        
        // Receipts subcollection: users/{userId}/stores/{storeId}/receipts/{receiptId}
        match /receipts/{receiptId} {
          // Helper function to check if authenticated user is staff (using collection group pattern)
          // Since Firestore rules can't easily check staff in any department with wildcards,
          // we allow staff members to create receipts when createdBy matches userId (which it does
          // for staff since both are set to super admin UID by app logic)
          function isStaffCreatingReceipt() {
            // When staff creates receipt:
            // - userId in path = super admin UID (from getQueryUserId)
            // - createdBy = super admin UID
            // - actualCreator = staff UID (if different from createdBy)
            // - request.auth.uid = staff UID
            // So we check if createdBy matches userId but auth.uid doesn't (indicating staff)
            return request.resource.data.createdBy == userId && 
                   request.auth.uid != userId &&
                   request.resource.data.createdBy != request.auth.uid;
          }
          
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid)
          // 2. User created the receipt (createdBy matches auth.uid)
          // 3. Staff member belongs to this store (can read all receipts in the store)
          // 4. Staff member accessing their own receipts (actualCreator matches their UID)
          allow read: if isAuthenticated() && 
                       (userId == request.auth.uid || 
                        resource.data.createdBy == request.auth.uid || 
                        exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)) ||
                        resource.data.actualCreator == request.auth.uid);
          
          // Allow create if:
          // 1. User is the super admin (userId in path matches auth.uid)
          // 2. Receipt createdBy matches super admin UID AND auth.uid doesn't match userId (staff creating)
          //    This allows staff to create receipts since app logic sets createdBy to super admin UID
          allow create: if isAuthenticated() && 
                         (userId == request.auth.uid || 
                          (request.resource.data.createdBy == userId && request.auth.uid != userId));
          
          // Allow update if:
          // 1. User is the super admin (userId in path) who created the receipt
          // 2. Staff member (actualCreator matches) - application code enforces manager-only restriction
          // Note: Application-level checks prevent non-managers from updating
          allow update: if isAuthenticated() && 
                         ((userId == request.auth.uid && resource.data.createdBy == request.auth.uid) || 
                          resource.data.actualCreator == request.auth.uid);
          
          // Allow delete if:
          // 1. User is the super admin (userId in path) who created the receipt
          // 2. Staff member (actualCreator matches) - application code enforces manager-only restriction
          // Note: Application-level checks prevent non-managers from deleting
          allow delete: if isAuthenticated() && 
                         ((userId == request.auth.uid && resource.data.createdBy == request.auth.uid) || 
                          resource.data.actualCreator == request.auth.uid);
        }
        
        // Customers subcollection: users/{userId}/stores/{storeId}/customers/{customerId}
        match /customers/{customerId} {
          // Allow read if user owns the store OR if staff member belongs to this store
          allow read: if isAuthenticated() && 
                       (resource.data.createdBy == request.auth.uid || 
                        exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)));
          
          // Allow create if user is creating their own customer OR if staff member belongs to this store
          allow create: if isAuthenticated() && 
                         (request.resource.data.createdBy == request.auth.uid || 
                          exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)));
          
          // Allow update if user owns the customer OR if staff member belongs to this store
          allow update: if isAuthenticated() && 
                         (resource.data.createdBy == request.auth.uid || 
                          exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)));
          
          // Allow delete if user owns the customer
          allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
        }
        
        // Notifications subcollection: users/{userId}/stores/{storeId}/notifications/{notificationId}
        match /notifications/{notificationId} {
          // Allow read if:
          // 1. User is the super admin (userId in path matches auth.uid)
          // 2. Staff member belongs to this store
          allow read: if isAuthenticated() && 
                       (userId == request.auth.uid || 
                        exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)));
          
          // Allow create if:
          // 1. User is the super admin (userId in path)
          // 2. Staff member belongs to this store
          allow create: if isAuthenticated() && 
                         (userId == request.auth.uid || 
                          exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)));
          
          // Allow update if:
          // 1. User is the super admin (userId in path)
          // 2. Staff member belongs to this store
          allow update: if isAuthenticated() && 
                         (userId == request.auth.uid || 
                          exists(/databases/$(database)/documents/users/$(userId)/stores/$(storeId)/departments/{departmentId}/staff/$(request.auth.uid)));
          
          // Allow delete if user is the super admin (userId in path)
          allow delete: if isAuthenticated() && userId == request.auth.uid;
        }
      }
    }
    
    // Legacy collections - keep for backward compatibility during migration
    // These will be removed after migration is complete
    match /stores/{storeId} {
      allow read, write: if false; // Deny all access to legacy stores collection
    }
    
    match /departments/{departmentId} {
      allow read, write: if false; // Deny all access to legacy departments collection
    }
    
    match /staff/{staffId} {
      allow read, write: if false; // Deny all access to legacy staff collection
    }
    
    match /inventoryFolders/{folderId} {
      allow read, write: if false; // Deny all access to legacy inventoryFolders collection
    }
    
    match /inventoryItems/{itemId} {
      allow read, write: if false; // Deny all access to legacy inventoryItems collection
    }
    
    match /receipts/{receiptId} {
      allow read, write: if false; // Deny all access to legacy receipts collection
    }
    
    match /customers/{customerId} {
      allow read, write: if false; // Deny all access to legacy customers collection
    }
    
    match /notifications/{notificationId} {
      allow read, write: if false; // Deny all access to legacy notifications collection
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
