rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Signed in, and for accounts with 2FA on, this sign-in passed it (see firestore.rules).
    function isAuthenticated() {
      return request.auth != null &&
        (request.auth.token.get('twoFactorEnabled', false) != true ||
         request.auth.token.auth_time in request.auth.token.get('tfaSessions', []));
    }

    function ownsStore(userId, storeId) {
      return isAuthenticated() &&
        userId == request.auth.uid &&
        firestore.exists(/databases/(default)/documents/users/$(userId)/stores/$(storeId)) &&
        firestore.get(/databases/(default)/documents/users/$(userId)/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    function hasActiveStoreMembership(userId, storeId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function canAccessStoreAssets(userId, storeId) {
      return ownsStore(userId, storeId) || hasActiveStoreMembership(userId, storeId);
    }

    // Replacing or deleting a store's images (logos, product photos): owner, branch admin, or a
    // member who manages products. Other members may only add new files. The membership is read
    // once: Storage rules allow only a few Firestore reads per request.
    function memberManagesProducts(member) {
      return member.get('status', '') == 'active' && (
        member.get('admin', false) == true ||
        member.get('permissions', {}).get('products', {}).get('edit', false) == true ||
        member.get('canManageInventory', false) == true
      );
    }

    function canManageStoreAssets(userId, storeId) {
      return ownsStore(userId, storeId) || (
        isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)) &&
        memberManagesProducts(firestore.get(/databases/(default)/documents/users/$(userId)/stores/$(storeId)/members/$(request.auth.uid)).data)
      );
    }

    // Every image is converted to WebP of at most 30 KB on the device (utils/image-upload.ts).
    function isAllowedImageUpload() {
      return request.resource.size > 0
        && request.resource.size <= 30 * 1024
        && request.resource.contentType == 'image/webp';
    }

    // Images: images/{userId}/profile/filename or images/{userId}/{folder}/filename
    // Authenticated users can read/write only their own images
    match /images/{userId}/{allPaths=**} {
      allow read, delete: if isAuthenticated() && request.auth.uid == userId;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && isAllowedImageUpload();
    }

    // Store images (for store-scoped uploads)
    // Path format: stores/{userId}/{storeId}/...
    match /stores/{userId}/{storeId}/{allPaths=**} {
      allow read: if canAccessStoreAssets(userId, storeId);
      // Writing over an existing file needs a product manager, however the write is classed.
      allow create: if canAccessStoreAssets(userId, storeId) && isAllowedImageUpload() &&
        (resource == null || canManageStoreAssets(userId, storeId));
      allow update: if canManageStoreAssets(userId, storeId) && isAllowedImageUpload();
      allow delete: if canManageStoreAssets(userId, storeId);
    }

    // Payment proofs (transfer screenshots). Kept outside stores/ so the store-wide asset rule
    // above cannot grant read or delete. Reads go through short-lived signed URLs issued by the
    // server; only the recorder may upload, once, while the payment awaits confirmation.
    function paymentDoc(userId, storeId, paymentId) {
      return /databases/(default)/documents/users/$(userId)/stores/$(storeId)/payments/$(paymentId);
    }

    // Photos: WebP up to 30 KB, like every other image. PDFs are not images and keep 5 MB.
    function isAllowedProofUpload(fileName) {
      return request.resource.size > 0
        && (
          (fileName == 'proof.webp'
            && request.resource.contentType == 'image/webp'
            && request.resource.size <= 30 * 1024)
          || (fileName == 'proof.pdf'
            && request.resource.contentType == 'application/pdf'
            && request.resource.size <= 5 * 1024 * 1024)
        );
    }

    match /paymentProofs/{userId}/{storeId}/{paymentId}/{fileName} {
      allow read, update, delete: if false;
      allow create: if isAuthenticated()
        && resource == null
        && isAllowedProofUpload(fileName)
        && canAccessStoreAssets(userId, storeId)
        && firestore.exists(paymentDoc(userId, storeId, paymentId))
        && firestore.get(paymentDoc(userId, storeId, paymentId)).data.recordedBy == request.auth.uid
        && firestore.get(paymentDoc(userId, storeId, paymentId)).data.status == 'awaiting_confirmation';
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
