{
  "crons": [
    {
      "path": "/api/cron/payments/anchor-audit",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/payments/proof-retention",
      "schedule": "45 1 * * *"
    },
    {
      "path": "/api/cron/payments/expire-links",
      "schedule": "*/15 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
