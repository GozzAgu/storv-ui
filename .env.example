NUXT_PUBLIC_FIREBASE_API_KEY=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_PROJECT_ID=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=yLaughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_APP_ID=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=Laughs_at_you_in_gozs_voice
# Web Google sign-in falls back to a full-page redirect when popups are blocked. For that to work
# in Safari/Firefox, set NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN to the app host (e.g. app.storvv.com);
# nuxt.config proxies /__/auth to Firebase. Add https://<that host>/__/auth/handler as an
# authorized redirect URI on the Web OAuth client in Google Cloud.
# Google sign-in. Web works once Google is enabled in Firebase Auth; iOS also needs these
# (Google Cloud → Credentials). Set the iOS app's GOOGLE_REVERSED_CLIENT_ID build setting too.
# NUXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# NUXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# Optional: account logos via Cloudinary (unsigned upload preset). When set, Settings uses Cloudinary instead of Firebase Storage for logos.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NUXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PLAN_MICRO_AMOUNT=0
PAYSTACK_PLAN_MEDIUM_AMOUNT=1500000
PAYSTACK_PLAN_ENTERPRISE_AMOUNT=2500000
# Optional billing-cycle overrides (kobo). If unset, quarterly = 3× monthly at 10% off; yearly = 12× at 15% off.
# PAYSTACK_PLAN_MEDIUM_AMOUNT_QUARTERLY=4050000
# PAYSTACK_PLAN_MEDIUM_AMOUNT_YEARLY=15300000
# PAYSTACK_PLAN_ENTERPRISE_AMOUNT_QUARTERLY=6750000
# PAYSTACK_PLAN_ENTERPRISE_AMOUNT_YEARLY=25500000
#
# Required for live / test subscription checkout (Paystack Dashboard → Plans → copy plan codes).
# Amounts above must match each plan’s amount in Paystack. Micro is free (no plan code).
# PAYSTACK_PLAN_CODE_MEDIUM_MONTHLY=PLN_xxxx
# PAYSTACK_PLAN_CODE_MEDIUM_QUARTERLY=PLN_xxxx
# PAYSTACK_PLAN_CODE_MEDIUM_YEARLY=PLN_xxxx
# PAYSTACK_PLAN_CODE_ENTERPRISE_MONTHLY=PLN_xxxx
# PAYSTACK_PLAN_CODE_ENTERPRISE_QUARTERLY=PLN_xxxx
# PAYSTACK_PLAN_CODE_ENTERPRISE_YEARLY=PLN_xxxx
#
# Enterprise add-ons: create two MONTHLY Paystack plans (₦5,000 extra store, ₦2,000 extra staff seat).
# Each purchase is its own subscription. Amounts default to these values when unset.
# PAYSTACK_ADDON_STORE_AMOUNT=500000
# PAYSTACK_ADDON_STAFF_AMOUNT=200000
# PAYSTACK_PLAN_CODE_ADDON_STORE=PLN_xxxx
# PAYSTACK_PLAN_CODE_ADDON_STAFF=PLN_xxxx
#
# Local/staging only: allow POST /api/dev/set-subscription without Paystack (also on when NODE_ENV=development).
# The Settings QA plan switcher UI is demo-mode only. Never enable this flag in production.
# NUXT_PUBLIC_ALLOW_DEV_PLAN_SWITCHER=1
# Platform fee (%) Storvv retains on each payment-link sale (0 = merchant keeps everything)
PAYMENT_LINK_PLATFORM_FEE_PERCENT=0
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=onboarding@resend.dev
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json

# Server-only: Firebase Admin (required for Paystack pending checkout + other server APIs).
# Download JSON from Firebase Console → Project settings → Service accounts → Generate new private key.
#
# Local: easiest is a file path (never commit the key file). Restart `nuxt dev` after editing .env.
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json
#
# Vercel Production: set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON (one line). Remove PATH-based vars
# there. Do not commit key files. Private-key \\n escaping is normalized in server/utils/firebase-admin.ts.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Optional on Vercel if inline JSON is painful: base64-encode the whole file, then:
# FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# Receipt delivery (email via Resend - required for email sends)
# 1. Create API key at https://resend.com/api-keys
# 2. For quick local testing: RESEND_FROM_EMAIL=onboarding@resend.dev (sends only to your Resend signup email)
# 3. Production: verify your domain in Resend, then use e.g. support@storvv.com or receipts@storvv.com
# Staff invite emails and receipt delivery use the same RESEND_* vars (server-side on Vercel).

# Storvv Assistant (Gemini - server-only). UI is always visible; chat works once this is set.
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# WhatsApp Business Cloud API (optional - without these, the app opens the device share sheet / WhatsApp)
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_API_VERSION=v21.0

# Optional error reporting (https://sentry.io). client plugin in plugins/02.observability.client.ts
# NUXT_PUBLIC_SENTRY_DSN=
# NUXT_PUBLIC_SENTRY_DEV=1
# Set before `npm run cap:build`, then rebuild in Xcode or Android Studio.
# NUXT_PUBLIC_API_BASE=https://app.storvv.com
# NUXT_PUBLIC_APP_ORIGIN=https://app.storvv.com
#
# Staff invite email runs on Vercel (RESEND_* + FIREBASE_SERVICE_ACCOUNT_JSON), not in the app bundle.
# See docs/ios-capacitor.md

# Optional: Vercel KV for distributed API rate limits (auto-set when KV is linked in Vercel).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
