# Firebase Configuration
# Copy this file to .env and fill in your actual Firebase credentials

# Staff invite (set-password email). Use ONE of:
# - FIREBASE_SERVICE_ACCOUNT_JSON = full JSON string from Firebase Console > Project Settings > Service Accounts > Generate new private key (single line)
# - FIREBASE_SERVICE_ACCOUNT_PATH = path to that JSON file (e.g. ./firebase-service-account.json)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

NUXT_PUBLIC_FIREBASE_API_KEY=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_PROJECT_ID=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=yLaughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_APP_ID=Laughs_at_you_in_gozs_voice
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=Laughs_at_you_in_gozs_voice
OPENAI_API_KEY=Laughs_at_you_in_gozs_voice

# Paystack (subscription payments) - get keys from https://dashboard.paystack.com
# Amounts in kobo (NGN): e.g. 500000 = 5,000 NGN
PAYSTACK_SECRET_KEY=sk_live_xxxx
PAYSTACK_PLAN_MICRO_AMOUNT=0
PAYSTACK_PLAN_MEDIUM_AMOUNT=500000
PAYSTACK_PLAN_ENTERPRISE_AMOUNT=1500000